# Environment Configuration
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/database-name?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-minimum-32-characters
JWT_EXPIRY=15m
JWT_ISSUER=arcade-notes-api
JWT_AUDIENCE=arcade-notes-client

# Admin User (for seeding)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=your-secure-admin-password

# iCafe API Configuration
ICAFE_CAFE_ID=your-cafe-id
ICAFE_AUTH_TOKEN=your-auth-token

# Frontend URLs (for CORS)
FRONTEND_URL=https://your-app.netlify.app
FRONTEND_URL_ALT=https://your-app.vercel.app
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=your-secure-admin-password

# iCafe API Configuration
ICAFE_CAFE_ID=your-cafe-id
ICAFE_AUTH_TOKEN=your-auth-token

# Frontend URLs (for CORS)
FRONTEND_URL=https://your-app.netlify.app
FRONTEND_URL_ALT=https://your-app.vercel.app